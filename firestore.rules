rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isSignedIn() && isValidId(chatId) && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isValidId(chatId) && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && isValidId(chatId) && request.auth.uid in resource.data.participantIds;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(messageId) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn() && isValidId(messageId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update: if isSignedIn() && isValidId(messageId) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow delete: if isSignedIn() && isValidId(messageId) &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // Status stories (24h expiring)
    match /statuses/{statusId} {
      allow read: if isSignedIn() && isValidId(statusId);
      allow create: if isSignedIn() && isValidId(statusId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(statusId); // To append to viewers
      allow delete: if isSignedIn() && isValidId(statusId) && resource.data.userId == request.auth.uid;
    }
  }
}
